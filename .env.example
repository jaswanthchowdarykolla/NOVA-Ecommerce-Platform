# Copy this file to .env and replace the example values before starting Docker Compose.
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nova
SPRING_DATASOURCE_USERNAME=nova
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-database-password
APP_CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
